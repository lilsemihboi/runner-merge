--!nonstrict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local BlockServiceClient = require(ReplicatedStorage.Shared.Services.BlockService.BlockServiceClient)
local FriendServiceClient = require(ReplicatedStorage.Shared.Services.FriendService.FriendServiceClient)
local InventoryServiceClient = require(ReplicatedStorage.Shared.Services.InventoryService.InventoryServiceClient)
local Menu = require(ReplicatedStorage.Shared.UI.App.Components.Menu)
local MonetizationServiceClient = require(ReplicatedStorage.Shared.Services.MonetizationService.MonetizationServiceClient)
local MountUI = require(ReplicatedStorage.Shared.UI.App.MountUI)
local OfflineEarningsServiceClient = require(ReplicatedStorage.Shared.Services.OfflineEarningsService.OfflineEarningsServiceClient)
local PlotServiceClient = require(ReplicatedStorage.Shared.Services.PlotService.PlotServiceClient)
local Products = require(ReplicatedStorage.Shared.Services.MonetizationService.Modules.Products)
local RebirthServiceClient = require(ReplicatedStorage.Shared.Services.RebirthService.RebirthServiceClient)
local RouteServiceClient = require(ReplicatedStorage.Shared.Services.RouteService.RouteServiceClient)
local RunnerManager = require(ReplicatedStorage.Shared.Classes.Runner.RunnerManager)
const RewardedAdServiceClient = require(ReplicatedStorage.Shared.Services.RewardedAdService.RewardedAdServiceClient)
local ShopSlice = require(ReplicatedStorage.Shared.UI.Shop.ShopSlice)
local StockServiceClient = require(ReplicatedStorage.Shared.Services.StockService.StockServiceClient)
local DataService = require(ReplicatedStorage.Packages.DataService).client

local function initializeOptionalFeature(featureName, initialize)
	task.spawn(function()
		local success, problem = xpcall(initialize, debug.traceback)
		if not success then
			warn(`[Startup] Optional client feature "{featureName}" failed to initialize and was disabled:\n{problem}`)
		end
	end)
end

DataService:init()
local analyticsSuccess, analyticsProblem = xpcall(function()
	require(ReplicatedStorage.Shared.Services.AnalyticsService.AnalyticsServiceClient):init()
end, debug.traceback)
if not analyticsSuccess then
	warn(`[Startup] Optional client feature "AnalyticsService" failed to initialize and was disabled:\n{analyticsProblem}`)
end
InventoryServiceClient:init()
BlockServiceClient:init()
-- Before monetization: product cost text reads stock as soon as it initialises.
StockServiceClient:init()
MonetizationServiceClient:init(Products)
initializeOptionalFeature("CodeService", function()
	require(ReplicatedStorage.Shared.Services.CodeService.CodeServiceClient):init()
end)
OfflineEarningsServiceClient:init()
initializeOptionalFeature("SoundService", function()
	require(ReplicatedStorage.Shared.Services.SoundService.SoundServiceClient):init()
end)
PlotServiceClient:init()
RouteServiceClient:init()
RebirthServiceClient:init()
initializeOptionalFeature("NotificationService", function()
	require(ReplicatedStorage.Shared.Services.NotificationService.NotificationServiceClient):init()
end)
FriendServiceClient:init()
RewardedAdServiceClient:init()
RunnerManager.new()
initializeOptionalFeature("LeaderboardService", function()
	require(ReplicatedStorage.Shared.Services.LeaderboardService.LeaderboardServiceClient):init()
end)
initializeOptionalFeature("AutoRejoinService", function()
	require(ReplicatedStorage.Shared.Services.AutoRejoinService.AutoRejoinServiceClient):init()
end)
initializeOptionalFeature("Feedback", function()
	require(ReplicatedStorage.Shared.Modules.Game.Feedback):init()
end)
initializeOptionalFeature("SettingsService", function()
	require(ReplicatedStorage.Shared.Services.SettingsService.SettingsServiceClient):init()
	require(ReplicatedStorage.Shared.Services.SettingsService.SettingsInitializer)()
end)
initializeOptionalFeature("Music", function()
	SoundService:WaitForChild("Music", 10):Play()
end)
initializeOptionalFeature("CarEngine", function()
	require(ReplicatedStorage.Shared.Services.SoundService.CarEngineInitializer)()
end)
initializeOptionalFeature("TitleService", function()
	require(ReplicatedStorage.Shared.Services.TitleService.TitleServiceClient):init()
end)
initializeOptionalFeature("TutorialService", function()
	require(ReplicatedStorage.Shared.Services.TutorialService.TutorialServiceClient):init()
end)
MountUI()
initializeOptionalFeature("GeneralNotificationsService", function()
	require(ReplicatedStorage.Shared.Services.GeneralNotificationsService.GeneralNotificationsServiceClient):init()
end)

MonetizationServiceClient.giftReceived:Connect(function(product, giftData)
	ShopSlice.state.giftReceivedData({
		product = product,
		giftData = giftData,
	})
	Menu.setOpenedMenu("GiftReceivedMenu")
end)
